#!/bin/sh
# build-paper [--soft] [paper-dir]
# Build <paper-dir>/paper.md (default 10_paper, run from the project root) with pandoc + citeproc:
# PDF via xelatex if present, else HTML. Then a compile guard fails on literal "???", unresolved
# citations (pandoc warnings), and missing include/image files. --soft turns failures into
# warnings and exits 0 (for hooks). Exit 2 on usage error or missing pandoc.
# Requires: pandoc; xelatex optional (PDF output).
soft=0
if [ "$1" = "--soft" ]; then soft=1; shift; fi
case "$1" in -h|--help) sed -n '2,7p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;; esac
dir=${1:-10_paper}
[ -f "$dir/paper.md" ] || { echo "build-paper: $dir/paper.md not found" >&2; exit 2; }
command -v pandoc >/dev/null 2>&1 || { echo "build-paper: pandoc not found on PATH" >&2; exit 2; }

if command -v xelatex >/dev/null 2>&1; then ext=pdf; engine="--pdf-engine=xelatex"; else ext=html; engine="--standalone"; fi
log="$dir/build.log"
{
  echo "pandoc: $(pandoc --version | head -n 1)"
  if [ "$ext" = pdf ]; then echo "xelatex: $(xelatex --version | head -n 1)"; else echo "xelatex: absent, building HTML"; fi
} > "$log"
cat "$log"

meta=""
[ -f "$dir/metadata.yaml" ] && meta="--metadata-file=metadata.yaml"
fails=""
cd "$dir" || exit 2
# shellcheck disable=SC2086
pandoc $meta --citeproc $engine -o "paper.$ext" paper.md 2>>build.log
rc=$?
tail -n +3 build.log
[ $rc -eq 0 ] || fails="$fails\npandoc exited $rc"

grep -qi 'citation .* not found\|Citeproc:.*not found' build.log && fails="$fails\nunresolved citations (see build.log)"
grep -qi 'Could not fetch resource\|File .* not found\|could not find\|Cannot find' build.log && fails="$fails\nmissing include/image file (see build.log)"
# images referenced in the source that do not exist
missing=$(sed -n 's/.*!\[[^]]*\](\([^) "]*\).*/\1/p' paper.md | while read -r f; do
  case "$f" in http*|"") ;; *) [ -e "$f" ] || echo "$f" ;; esac; done)
[ -z "$missing" ] || fails="$fails\nmissing file(s): $(echo $missing)"
# literal ??? in source or output
if grep -q '???' paper.md; then fails="$fails\n??? found in paper.md"; fi
if [ "$ext" = html ]; then
  grep -q '???' paper.html && fails="$fails\n??? found in paper.html"
elif command -v pdftotext >/dev/null 2>&1 && [ -f paper.pdf ]; then
  pdftotext paper.pdf - 2>/dev/null | grep -q '???' && fails="$fails\n??? found in paper.pdf"
fi

if [ -n "$fails" ]; then
  printf 'build-paper: guard FAILED:%b\n' "$fails" >&2
  [ $soft -eq 1 ] && { echo "build-paper: --soft, exiting 0" >&2; exit 0; }
  exit 1
fi
echo "build-paper: OK -> $dir/paper.$ext"
